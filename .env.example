# Demo mode is used when these are blank.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

# Public browser-facing Jellyfin URL on your home network.
# Example: http://192.168.50.20:8096
NEXT_PUBLIC_JELLYFIN_URL=http://localhost:8096

# Server-side PostgreSQL 18 connection (reelhouse database). Blank = no
# database features (demo mode). Credentials stay server-side; they are
# never sent to the browser. Migrations and the smoke check target the
# same URL, or override with MIGRATION_DATABASE_URL for a disposable
# database. See docs/DATABASE.md and docs/DB_SMOKE.md.
# Example: postgresql://reelhouse_app:CHANGE_ME@192.168.50.20:5432/reelhouse
DATABASE_URL=

# Server-side PostgreSQL 18 connection for the separate media_catalog
# database (normalized catalog data synced from Jellyfin; see
# docs/ARCHITECTURE.md and docs/CATALOG_SYNC.md). Blank = catalog sync
# unavailable (the app keeps serving the live Jellyfin proxy/demo).
# Example: postgresql://catalog_app:CHANGE_ME@192.168.50.20:5432/media_catalog
MEDIA_CATALOG_DATABASE_URL=

# Catalog sync policy: items absent from full scans for this many days are
# retired (non-destructive; rows are kept, reads filter them). Default 30.
MEDIA_CATALOG_RETIREMENT_DAYS=30

# Backup/restore tooling (docs/BACKUP_RESTORE.md). The scratch database is
# dropped and recreated by restore verification, so its name must stay in
# the rh_restore_* namespace below — never point it at a real database.
# Example: postgresql://reelhouse_owner:CHANGE_ME@192.168.50.20:5432/rh_restore_check
RESTORE_VERIFY_DATABASE_URL=

# Freshness bound (hours) for backup verification. Older backups fail
# closed. Default 168 (one week).
BACKUP_MAX_AGE_HOURS=168
