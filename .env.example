# Demo mode is used when these are blank.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

# Public browser-facing Jellyfin URL on your home network.
# Example: http://192.168.50.20:8096
NEXT_PUBLIC_JELLYFIN_URL=http://localhost:8096

# Server-side PostgreSQL 18 connection (reelhouse database), least-privilege
# application role. Blank = no database features (demo mode). Credentials
# stay server-side; they are never sent to the browser. See docs/DATABASE.md.
# Example: postgresql://reelhouse_app:CHANGE_ME@192.168.50.20:5432/reelhouse
DATABASE_URL=

# Owner/migrator role used only by `npm run db:migrate`. Falls back to
# DATABASE_URL when unset. Never exposed to the application runtime.
# Example: postgresql://reelhouse_owner:CHANGE_ME@192.168.50.20:5432/reelhouse
DATABASE_MIGRATE_URL=

# Explicit application role name for migration grants ({{app_role}}).
# Defaults to the user in DATABASE_URL. See docs/DATABASE.md.
DATABASE_APP_ROLE=

# Full-library catalog sync (`npm run catalog:sync`, server-side only).
# Requires DATABASE_URL (application role) plus JELLYFIN_URL and
# JELLYFIN_API_KEY above; migrations must already be applied. See docs/CATALOG.md.
# Optional bounded tuning overrides:
# CATALOG_SYNC_HTTP_TIMEOUT_MS=30000
# CATALOG_SYNC_BATCH_SIZE=500

# Household import (`npm run household:import`, server-side only). Takes a
# complete household snapshot JSON (profiles, preferences, favorites,
# watchlists, collections, home rows, watch state, playback history,
# Jellyfin links) and lands it idempotently in PostgreSQL. Requires
# DATABASE_URL and applied migrations; the manifest path may also be passed
# as the CLI argument (argument wins). See docs/HOUSEHOLD.md.
# HOUSEHOLD_IMPORT_FILE=

# Disaster recovery (`npm run dr`, server-side only; see
# docs/DISASTER_RECOVERY.md). `backup` writes the household artifact into
# --out (or DR_BACKUP_DIR); `restore` reads --file (or DR_RESTORE_FILE, the
# argument wins). Both checksums printed by `dr backup` must be recorded
# OUTSIDE the database — on a lost database they are the only binding left.
# DR_BACKUP_DIR=var/backups
# DR_RESTORE_FILE=

# Optional bounded tuning overrides (defaults in docs/DATABASE.md):
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_STATEMENT_TIMEOUT_MS=10000
# JELLYFIN_HEALTH_TIMEOUT_MS=3000
