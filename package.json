{
  "name": "reelhouse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/lib/db/config.test.ts src/lib/db/migrator.test.ts src/lib/db/smoke.test.ts src/lib/catalog/config.test.ts src/lib/catalog/model.test.ts src/lib/catalog/client.test.ts src/lib/household/household.test.ts src/lib/household/model.test.ts src/lib/household/reconcile.test.ts",
    "test:db": "node --test src/lib/db/migrations.int.test.ts src/lib/db/smoke.int.test.ts src/lib/catalog/catalog.int.test.ts src/lib/household/household.int.test.ts src/lib/household/household-lists.int.test.ts src/lib/household/watch-progress.int.test.ts",
    "test:db:up": "docker compose -f docker-compose.test-db.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test-db.yml down -v",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:migrate:dry-run": "node scripts/db-migrate.ts --dry-run",
    "db:smoke": "node scripts/db-smoke.ts",
    "catalog:migrate": "node scripts/catalog-migrate.ts",
    "catalog:migrate:dry-run": "node scripts/catalog-migrate.ts --dry-run",
    "catalog:sync": "node scripts/catalog-sync.ts",
    "catalog:sync:full": "node scripts/catalog-sync.ts --full",
    "catalog:rebuild": "node scripts/catalog-sync.ts --rebuild"
  },
  "dependencies": {
    "next": "16.0.1",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.1",
    "typescript": "5.9.3"
  }
}
