{
  "name": "reelhouse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/lib/db/config.test.ts src/lib/db/migrator.test.ts src/lib/jellyfin-health.test.ts src/lib/catalog/config.test.ts src/lib/catalog/model.test.ts src/lib/catalog/client.test.ts src/lib/household/household.test.ts",
    "test:int": "node --test src/lib/db/integration.int.test.ts src/lib/catalog/catalog.int.test.ts src/lib/household/household.int.test.ts src/lib/household/lists.int.test.ts",
    "db:migrate": "node scripts/db-migrate.ts",
    "catalog:migrate": "node scripts/catalog-migrate.ts",
    "catalog:sync": "node scripts/catalog-sync.ts",
    "catalog:sync:full": "node scripts/catalog-sync.ts --mode full",
    "catalog:sync:rebuild": "node scripts/catalog-sync.ts --mode rebuild"
  },
  "dependencies": {
    "next": "16.0.1",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.1",
    "typescript": "5.9.3"
  }
}
